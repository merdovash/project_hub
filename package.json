{
  "name": "portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:bootstrap": "node ./node_modules/vite-node/vite-node.mjs server/db/cli.ts bootstrap",
    "db:migrate": "node ./node_modules/vite-node/vite-node.mjs server/db/cli.ts migrate",
    "db:seed": "node ./node_modules/vite-node/vite-node.mjs server/db/cli.ts seed",
    "db:setup": "node ./node_modules/vite-node/vite-node.mjs server/db/cli.ts setup",
    "sync": "node ./scripts/sync-services.mjs",
    "sync:caddy": "node ./scripts/sync-services.mjs --caddy-only",
    "deploy": "bash ./scripts/deploy.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  }
}
