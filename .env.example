DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
# Superuser for first-time create role/db (npm run db:bootstrap / db:setup). Not needed after that.
# PG_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Parent domain for SSO cookie (empty in local host-only dev)
# COOKIE_DOMAIN=.example.com

# Optional override path to services registry
# SERVICES_CONFIG=/etc/portal/services.yaml
