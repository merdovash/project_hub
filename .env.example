DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
# Superuser for first-time create role/db (npm run db:bootstrap / db:setup). Not needed after that.
# PG_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Public domain (overrides config/services.yaml). Used for catalog links + Caddy sync.
DOMAIN=example.com
COOKIE_DOMAIN=.example.com
PORTAL_URL=https://example.com
VITE_PORTAL_URL=https://example.com

# Optional override path to services registry
# SERVICES_CONFIG=/etc/portal/services.yaml

# Telegram ops bot (deploy/BOT.md). All keys are hub-only (not copied to child services).
# TELEGRAM_BOT_TOKEN=123456789:AA...            # from @BotFather
# BOT_PASSWORD_HASH=scrypt$...                  # npm run bot:password -- 'пароль'
# TELEGRAM_ALLOWED_USER_IDS=11111111,22222222   # optional but recommended (@userinfobot)
# BOT_SESSION_TTL_HOURS=24
